<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 浩辰 CAD 2025 托管宿主使用 .NET Framework 4.8。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <RootNamespace>TruckTurn</RootNamespace>
    <AssemblyName>TruckTurn.GstarCAD2025</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>5.3.0</Version>
    <AssemblyVersion>5.3.0.0</AssemblyVersion>
    <FileVersion>5.3.0.0</FileVersion>
    <AssemblyTitle>货车转弯路径模拟插件（浩辰 CAD 2025）</AssemblyTitle>
    <Product>TruckTurn</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 2026 工程共享同一份业务源码，避免两个版本的算法发生漂移。 -->
    <Compile Include="..\TruckTurn\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      仅作为编译引用，交付时不复制。NETLOAD 后由浩辰 CAD 2025
      从自身安装目录提供相同的 Gc*.dll。
    -->
    <Reference Include="GcMgd">
      <HintPath>..\lib2025\GcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GcDbMgd">
      <HintPath>..\lib2025\GcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GcCoreMgd">
      <HintPath>..\lib2025\GcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
